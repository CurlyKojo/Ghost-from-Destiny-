[Unit]
Description=Destiny Ghost voice companion
After=network-online.target sound.target
Wants=network-online.target

[Service]
# root is needed for the NeoPixel ring (rpi_ws281x uses PWM/DMA)
User=root
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python -m ghost.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
