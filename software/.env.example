# Copy to software/.env and fill in.  Anything unset falls back to the defaults in ghost/config.py.
ANTHROPIC_API_KEY=sk-ant-...
GHOST_GUARDIAN_NAME=Guardian
GHOST_CITY=Denver
GHOST_TZ=America/Denver

# Brain
GHOST_MODEL=claude-opus-5
GHOST_EFFORT=low

# Voice: piper (offline) or elevenlabs (cloud)
GHOST_TTS=piper
PIPER_MODEL=/home/pi/ghost/software/models/en_US-ryan-medium.onnx
GHOST_VOICE_PITCH=1.06
GHOST_VOICE_FX=true
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Wake word
GHOST_WAKE_MODEL=/home/pi/ghost/software/models/hey_ghost.onnx
GHOST_WAKE_THRESHOLD=0.5

# Audio devices (leave blank for ALSA default)
GHOST_INPUT_DEVICE=
GHOST_OUTPUT_DEVICE=
GHOST_VOLUME=0.8

# Servos (find your centres with tools/servo_calibrate.py)
GHOST_SERVOS=true
GHOST_PAN_CENTER=90
GHOST_TILT_CENTER=90

# Home Assistant (optional)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
